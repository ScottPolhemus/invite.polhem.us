DATABASE_URL=postgres://invite:invite@localhost:5432/invite

# Public origin of the app. In dev use 127.0.0.1 (atproto loopback OAuth client).
PUBLIC_URL=http://127.0.0.1:3000

# openssl rand -base64 32
SESSION_SECRET=

# Production only: ES256 private JWK (JSON, single line) used for private_key_jwt
OAUTH_PRIVATE_JWK=

# Bearer token required by /api/cron/ingest
CRON_SECRET=dev-cron-secret

JETSTREAM_URL=https://jetstream.us-east.bsky.network

# Optional: enables Jetstream replay (the archive) so ingest catches up after downtime
JETSTREAM_API_TOKEN=
