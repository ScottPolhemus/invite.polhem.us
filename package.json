    "@bsky/jetstream": "^1.0.0",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.13",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@atproto/common-web": "^0.5.15",
    "@atproto/crypto": "^0.5.7",
    "@tailwindcss/turbopack": "^4",
